{
  "name": "ReadMirror for Medium.com (Unofficial)",
  "short_name": "ReadMirror",
  "version": "0.1.1",
  "manifest_version": 3,
  "description": "Redirects Medium articles to the Freedium mirror and applies a clean, configurable reading UI.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://medium.com/*",
    "http://medium.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "medium-to-freedium",
        "enabled": false,
        "path": "rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://freedium.cfd/medium.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.medium.com/*",
        "http://*.medium.com/*"
      ],
      "js": [
        "detect.js"
      ],
      "run_at": "document_start"
    }
  ]
  ,
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open in ReadMirror",
    "default_popup": "popup.html"
  }
}


